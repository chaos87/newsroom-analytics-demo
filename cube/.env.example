# ─── Warehouse: Neon PostgreSQL (the demo's dbt target) ────────────────────
# Host/user/password from your Neon project (or any Postgres running the dbt
# layer). Connection is TLS-encrypted — required by Neon.
CUBEJS_DB_HOST=<your-neon-host>.neon.tech
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=neondb
CUBEJS_DB_USER=neondb_owner
CUBEJS_DB_PASS=<password>
CUBEJS_DB_SSL=true

# ─── Cube ────────────────────────────────────────────────────────────────────
CUBEJS_DEV_MODE=true
# Any long random string for local dev; use a real secret in any shared env.
CUBEJS_API_SECRET=<generate-a-random-secret>
CUBEJS_WEB_SOURCES=true